# BLE values must exactly match the ESP32/GATT peripheral.
EXPO_PUBLIC_BLE_SERVICE_UUID=12345678-1234-1234-1234-1234567890ab
EXPO_PUBLIC_BLE_CHARACTERISTIC_UUID=12345678-1234-1234-1234-1234567890ac
# Optional. Leave blank to match any device advertising the service UUID.
EXPO_PUBLIC_BLE_DEVICE_NAME=ESP32-Sensor
